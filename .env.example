# ตัวอย่างตัวแปรสำหรับตั้งค่าบน Railway (Variables) หรือ Docker (.env)
# คัดลอกค่าจริงที่ได้จาก config.json หลังรัน 1_LOGIN.bat มาใส่

AUTH_TOKEN=YOUR_AUTH_TOKEN_FROM_CONFIG_JSON
GROUP_A_ID=c0123456789abcdef0123456789abcdef
GROUP_B_ID=c9876543210fedcba9876543210fedcba
TIMEOUT_SECONDS=90

# (ตัวเลือกเสริม) Proxy Gateway หากรันบน Cloud/Railway แล้วติด 403 Forbidden
# LINE_PROXY=http://user:pass@host:port
